<UserControl x:Class="LeftoverScout.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeftoverScout.App.ViewModels"
             xmlns:results="clr-namespace:LeftoverScout.Core.Results;assembly=LeftoverScout.Core">
  <UserControl.Resources>
    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- No scan yet -->
    <StackPanel Visibility="{Binding HasNoResult, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,12,0,0" Text="{Binding NoResultMessage}" TextWrapping="Wrap" />
      <Button MinWidth="110"
              Margin="0,16,0,0"
              HorizontalAlignment="Left"
              Command="{Binding GoToScanCommand}"
              Content="Go to Scan" />
    </StackPanel>

    <!-- Result available -->
    <Grid Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Grid.Row="1" Margin="0,4,0,8" Text="{Binding HeaderText}" TextWrapping="Wrap" />

      <Border Grid.Row="2" Margin="0,0,0,8"
              Padding="10,8"
              Background="#FFFFF4CE"
              BorderBrush="#FFE5CC73"
              BorderThickness="1"
              Visibility="{Binding IsResultStale, Converter={StaticResource BooleanToVisibility}}">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right"
                  Margin="12,0,0,0"
                  Command="{Binding GoToScanCommand}"
                  Content="Go to Scan" />
          <TextBlock VerticalAlignment="Center" Text="{Binding StaleMessage}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <TabControl Grid.Row="3">
        <TabItem Header="Folders">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Up, breadcrumb and row actions -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenFolderInExplorerCommand}"
                        Content="Open in Explorer" />
                <Button Margin="8,0,0,0"
                        Command="{Binding CopyFolderPathCommand}"
                        Content="Copy path" />
              </StackPanel>
              <Button MinWidth="60"
                      Margin="0,0,8,0"
                      Command="{Binding UpCommand}"
                      Content="Up" />
              <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type results:BreadcrumbItem}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="2,0" VerticalAlignment="Center" Text="›"
                                 Visibility="{Binding ShowSeparator, Converter={StaticResource BooleanToVisibility}}" />
                      <Button Padding="6,2"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Content="{Binding Label}"
                              ToolTip="{Binding Node.FullPath}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>

            <!-- Folder table. DataGrid virtualization: EnableRowVirtualization and VirtualizingPanel.IsVirtualizing. -->
            <DataGrid x:Name="FolderGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding Rows}"
                      MouseDoubleClick="FolderGrid_MouseDoubleClick"
                      PreviewKeyDown="FolderGrid_PreviewKeyDown"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open in Explorer"
                            Command="{Binding PlacementTarget.DataContext.OpenFolderInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  <MenuItem Header="Copy path"
                            Command="{Binding PlacementTarget.DataContext.CopyFolderPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            InputGestureText="Ctrl+C" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Width="2*" Header="Name" SortMemberPath="Name"
                                    Binding="{Binding Name, Mode=OneWay}" />
                <DataGridTextColumn Width="90" Header="Size" SortMemberPath="Size"
                                    Binding="{Binding SizeText, Mode=OneWay}"
                                    ElementStyle="{StaticResource RightAlignedCell}" />
                <DataGridTemplateColumn Width="150" Header="% of parent" SortMemberPath="PercentOfParent">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="4" Margin="0,0,6,0" Maximum="100" Minimum="0"
                                     Value="{Binding PercentOfParent, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding PercentText}" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="80" Header="Files" SortMemberPath="Files"
                                    Binding="{Binding FilesText, Mode=OneWay}"
                                    ElementStyle="{StaticResource RightAlignedCell}" />
                <DataGridTextColumn Width="140" Header="Last modified" SortMemberPath="LastModified"
                                    Binding="{Binding LastModifiedText, Mode=OneWay}" />
                <DataGridTemplateColumn Width="*" Header="Notes" SortMemberPath="NotesText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                      <TextBlock Text="{Binding NotesText}" ToolTip="{Binding NotesTooltip}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding FolderSummaryText}" />
          </Grid>
        </TabItem>

        <TabItem Header="Large files">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
              <Button Command="{Binding OpenFileInExplorerCommand}" Content="Open in Explorer" />
              <Button Margin="8,0,0,0" Command="{Binding CopyFilePathCommand}" Content="Copy path" />
            </StackPanel>

            <DataGrid x:Name="LargeFilesGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding LargeFiles}"
                      PreviewKeyDown="LargeFilesGrid_PreviewKeyDown"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      SelectedItem="{Binding SelectedLargeFile, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Visibility="{Binding HasLargeFiles, Converter={StaticResource BooleanToVisibility}}">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open in Explorer"
                            Command="{Binding PlacementTarget.DataContext.OpenFileInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  <MenuItem Header="Copy path"
                            Command="{Binding PlacementTarget.DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            InputGestureText="Ctrl+C" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="3*" Header="Path" SortMemberPath="RelativePath">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:LargeFileRowViewModel}">
                      <TextBlock Text="{Binding RelativePath}"
                                 ToolTip="{Binding FullPath}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="90" Header="Size" SortMemberPath="Size"
                                    Binding="{Binding SizeText, Mode=OneWay}"
                                    ElementStyle="{StaticResource RightAlignedCell}" />
                <DataGridTextColumn Width="140" Header="Last modified" SortMemberPath="LastModified"
                                    Binding="{Binding LastModifiedText, Mode=OneWay}" />
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1"
                       Margin="4,8,0,0"
                       IsHitTestVisible="False"
                       Text="{Binding NoLargeFilesMessage}"
                       Visibility="{Binding HasNoLargeFiles, Converter={StaticResource BooleanToVisibility}}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
