<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF user interface (MVVM). Contains no scanning or deletion logic itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LeftoverScout.App</RootNamespace>
    <AssemblyName>LeftoverScout</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- The help files are the single source for GitHub and for the in-app Help (decision D-027). They are linked, not copied. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\user-guide\**\*.md" LogicalName="Help/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeftoverScout.Core\LeftoverScout.Core.csproj" />
    <ProjectReference Include="..\LeftoverScout.Windows\LeftoverScout.Windows.csproj" />
  </ItemGroup>

</Project>
