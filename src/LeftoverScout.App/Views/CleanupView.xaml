<UserControl x:Class="LeftoverScout.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style x:Key="WrappedCell" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WarningBox" TargetType="Border">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="#FFFFF4CE" />
      <Setter Property="BorderBrush" Value="#FFE5CC73" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- 1. Nothing selected -->
    <StackPanel Visibility="{Binding IsNothingSelected, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,12,0,0" Text="{Binding NothingSelectedMessage}" TextWrapping="Wrap" />
      <Button MinWidth="110"
              Margin="0,16,0,0"
              HorizontalAlignment="Left"
              Command="{Binding GoToFindingsCommand}"
              Content="Go to Findings" />
    </StackPanel>

    <!-- Checking -->
    <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,12,0,0" Text="{Binding CheckingMessage}" />
      <ProgressBar Height="6" Margin="0,12,0,0" IsIndeterminate="True" />
    </StackPanel>

    <!-- 2. Review -->
    <Grid Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Margin="0,4,0,8" Text="Review the items below. Only items marked Ready will be cleaned." TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1">
        <Border Style="{StaticResource WarningBox}" Visibility="{Binding HasRunningWarning, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding RunningWarning}" TextWrapping="Wrap" />
        </Border>
        <Border Style="{StaticResource WarningBox}" Visibility="{Binding HasReviewMessage, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding ReviewMessage}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <DataGrid Grid.Row="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ReviewRows}"
                SelectionMode="Single"
                SelectionUnit="FullRow">
        <DataGrid.Columns>
          <DataGridTextColumn Width="3*" Header="Path" SortMemberPath="Path"
                              Binding="{Binding Path, Mode=OneWay}" />
          <DataGridTextColumn Width="90" Header="Kind" SortMemberPath="KindText"
                              Binding="{Binding KindText, Mode=OneWay}" />
          <DataGridTextColumn Width="90" Header="Confidence" SortMemberPath="ConfidenceText"
                              Binding="{Binding ConfidenceText, Mode=OneWay}" />
          <DataGridTextColumn Width="85" Header="Size" SortMemberPath="Size"
                              Binding="{Binding SizeText, Mode=OneWay}"
                              ElementStyle="{StaticResource RightAlignedCell}" />
          <DataGridTextColumn Width="2*" Header="Status" SortMemberPath="StatusText"
                              Binding="{Binding StatusText, Mode=OneWay}"
                              ElementStyle="{StaticResource WrappedCell}" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <TextBlock Margin="0,0,0,8"
                   Text="{Binding MergedLine}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasMergedLine, Converter={StaticResource BooleanToVisibility}}" />
        <StackPanel Orientation="Horizontal">
          <RadioButton Margin="0,0,16,0"
                       Content="{Binding RecycleBinModeLabel}"
                       GroupName="CleanupMode"
                       IsChecked="{Binding IsRecycleBinMode, Mode=TwoWay}" />
          <RadioButton Content="{Binding PermanentModeLabel}"
                       GroupName="CleanupMode"
                       IsChecked="{Binding IsPermanentMode, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Margin="0,4,0,0" Text="{Binding ModeNote}" TextWrapping="Wrap" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding TotalsText}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button MinWidth="110" Command="{Binding StartCleanupCommand}" Content="Start cleanup" />
            <Button MinWidth="110" Margin="8,0,0,0" Command="{Binding GoToFindingsCommand}" Content="Back to Findings" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Grid>

    <!-- 4. Running -->
    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,12,0,0" FontSize="16" Text="Cleaning up…" />
      <ProgressBar Height="14" Margin="0,12,0,0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
      <TextBlock Margin="0,8,0,0" Text="{Binding ProgressText}" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" Text="{Binding CurrentItemText}" TextTrimming="CharacterEllipsis" />
      <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
        <Button MinWidth="110" Command="{Binding CancelCleanupCommand}" Content="Cancel" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding RunningHint}" />
      </StackPanel>
    </StackPanel>

    <!-- 5. Summary -->
    <Grid Visibility="{Binding IsSummary, Converter={StaticResource BooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding SummaryTitle}" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SummaryLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding BytesRemovedText}" />
        <TextBlock Margin="0,4,0,8"
                   Text="{Binding RecycleBinNote}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasRecycleBinNote, Converter={StaticResource BooleanToVisibility}}" />
        <Border Style="{StaticResource WarningBox}" Visibility="{Binding HasUnexpectedPermanentWarning, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding UnexpectedPermanentWarning}" TextWrapping="Wrap" />
        </Border>
        <Border Style="{StaticResource WarningBox}" Visibility="{Binding HasJournalWarning, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding JournalWarning}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <DataGrid Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ResultRows}"
                SelectionMode="Single"
                SelectionUnit="FullRow">
        <DataGrid.Columns>
          <DataGridTextColumn Width="3*" Header="Path" Binding="{Binding Path, Mode=OneWay}" />
          <DataGridTextColumn Width="85" Header="Size" Binding="{Binding SizeText, Mode=OneWay}"
                              ElementStyle="{StaticResource RightAlignedCell}" />
          <DataGridTextColumn Width="120" Header="Outcome" Binding="{Binding OutcomeText, Mode=OneWay}" />
          <DataGridTextColumn Width="3*" Header="Reason" Binding="{Binding ReasonText, Mode=OneWay}"
                              ElementStyle="{StaticResource WrappedCell}" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button MinWidth="110" Command="{Binding OpenHistoryCommand}" Content="Open History" />
        <Button MinWidth="110" Margin="8,0,0,0" Command="{Binding OpenRecycleBinCommand}" Content="Open Recycle Bin" />
        <Button MinWidth="110" Margin="8,0,0,0" Command="{Binding ScanAgainCommand}" Content="Scan again" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
