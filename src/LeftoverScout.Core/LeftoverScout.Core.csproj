<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent domain logic: models, rules engine, classification. No Windows APIs here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LeftoverScout.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The rules knowledge base is embedded, not copied (decision D-040). Logical names: Rules/<file>.json -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\*.json" LogicalName="Rules/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeftoverScout.Core.Tests" />
  </ItemGroup>

</Project>
