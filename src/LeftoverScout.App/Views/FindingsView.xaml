<UserControl x:Class="LeftoverScout.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LeftoverScout.App.ViewModels">
  <UserControl.Resources>
    <Style x:Key="RightAlignedCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style x:Key="DetailsLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,12,2" />
    </Style>
    <Style x:Key="DetailsValue" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- No scan yet -->
    <StackPanel Visibility="{Binding HasNoResult, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Margin="0,12,0,0" Text="{Binding NoResultMessage}" TextWrapping="Wrap" />
      <Button MinWidth="110"
              Margin="0,16,0,0"
              HorizontalAlignment="Left"
              Command="{Binding GoToScanCommand}"
              Content="Go to Scan" />
    </StackPanel>

    <!-- Result available -->
    <Grid Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
      <TextBlock Grid.Row="1" Margin="0,4,0,4" Text="{Binding HeaderText}" TextWrapping="Wrap" />

      <!-- Filters and search -->
      <WrapPanel Grid.Row="2" Margin="0,4,0,8">
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="High" IsChecked="{Binding ShowHigh, Mode=TwoWay}" />
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Medium" IsChecked="{Binding ShowMedium, Mode=TwoWay}" />
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Low" IsChecked="{Binding ShowLow, Mode=TwoWay}" />
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Cache" IsChecked="{Binding ShowCache, Mode=TwoWay}" />
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Temp" IsChecked="{Binding ShowTemp, Mode=TwoWay}" />
        <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Logs" IsChecked="{Binding ShowLogs, Mode=TwoWay}" />
        <CheckBox Margin="0,0,16,0" VerticalAlignment="Center" Content="Crash dumps" IsChecked="{Binding ShowCrashDumps, Mode=TwoWay}" />
        <TextBlock VerticalAlignment="Center" Text="Search" />
        <TextBox Width="200"
                 Margin="8,0,0,0"
                 AutomationProperties.Name="Search"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      </WrapPanel>

      <Grid Grid.Row="3">
        <DataGrid x:Name="FindingsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  EnableRowVirtualization="True"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Rows}"
                  PreviewKeyDown="FindingsGrid_PreviewKeyDown"
                  PreviewMouseRightButtonDown="FindingsGrid_PreviewMouseRightButtonDown"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open in Explorer"
                        Command="{Binding PlacementTarget.DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="Copy path"
                        Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        InputGestureText="Ctrl+C" />
              <MenuItem Header="Show in Results"
                        Command="{Binding PlacementTarget.DataContext.ShowInResultsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Width="3*" Header="Path" SortMemberPath="Path"
                                Binding="{Binding Path, Mode=OneWay}" />
            <DataGridTextColumn Width="95" Header="Kind" SortMemberPath="KindText"
                                Binding="{Binding KindText, Mode=OneWay}" />
            <DataGridTextColumn Width="90" Header="Confidence" SortMemberPath="ConfidenceRank"
                                Binding="{Binding ConfidenceText, Mode=OneWay}" />
            <DataGridTextColumn Width="85" Header="Size" SortMemberPath="Size"
                                Binding="{Binding SizeText, Mode=OneWay}"
                                ElementStyle="{StaticResource RightAlignedCell}" />
            <DataGridTextColumn Width="130" Header="Last modified" SortMemberPath="LastModified"
                                Binding="{Binding LastModifiedText, Mode=OneWay}" />
            <DataGridTextColumn Width="*" Header="Program" SortMemberPath="Program"
                                Binding="{Binding Program, Mode=OneWay}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state over the grid; it must never catch mouse clicks. -->
        <TextBlock Margin="4,36,0,0"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   Text="{Binding EmptyMessage}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasEmptyMessage, Converter={StaticResource BooleanToVisibility}}" />
      </Grid>

      <!-- Total and actions -->
      <DockPanel Grid.Row="4" Margin="0,8,0,8" LastChildFill="False">
        <TextBlock VerticalAlignment="Center" Text="{Binding TotalText}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Margin="8,0,0,0" Command="{Binding OpenInExplorerCommand}" Content="Open in Explorer" />
          <Button Margin="8,0,0,0" Command="{Binding CopyPathCommand}" Content="Copy path" />
          <Button Margin="8,0,0,0" Command="{Binding ShowInResultsCommand}" Content="Show in Results" />
        </StackPanel>
      </DockPanel>

      <!-- Details of the selected row -->
      <Border Grid.Row="5"
              Height="170"
              Padding="10,8"
              BorderBrush="LightGray"
              BorderThickness="1">
        <Grid>
          <TextBlock IsHitTestVisible="False"
                     Text="{Binding NoSelectionMessage}"
                     Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibility}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
            <Grid DataContext="{Binding SelectedRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Style="{StaticResource DetailsLabel}" Text="Path" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding FullPath}" />
              <TextBlock Grid.Row="1" Style="{StaticResource DetailsLabel}" Text="Kind" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding KindText}" />
              <TextBlock Grid.Row="2" Style="{StaticResource DetailsLabel}" Text="Confidence" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding ConfidenceText}" />
              <TextBlock Grid.Row="3" Style="{StaticResource DetailsLabel}" Text="Size" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailsValue}">
                <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FilesText, Mode=OneWay}" /><Run Text=" files" />
              </TextBlock>
              <TextBlock Grid.Row="4" Style="{StaticResource DetailsLabel}" Text="Last modified" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding LastModifiedText}" />
              <TextBlock Grid.Row="5" Style="{StaticResource DetailsLabel}" Text="Program" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding Program}" />
              <TextBlock Grid.Row="6" Style="{StaticResource DetailsLabel}" Text="Why" />
              <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding ExplanationText}" />
              <TextBlock Grid.Row="7" Style="{StaticResource DetailsLabel}" Text="Rule"
                         Visibility="{Binding HasRule, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailsValue}" Text="{Binding RuleText}"
                         Visibility="{Binding HasRule, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource DetailsValue}" Text="{Binding InsideNote}"
                         Visibility="{Binding IsNested, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
