<UserControl x:Class="LeftoverScout.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding AppName}" />
    <TextBlock Margin="0,8,0,0" Text="{Binding Version, StringFormat=Version {0}}" />
    <TextBlock Margin="0,4,0,0" Text="{Binding License}" />
    <Button Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Command="{Binding OpenRepositoryCommand}"
            Content="{Binding Repository}" />

    <TextBlock Margin="0,24,0,0" FontWeight="SemiBold" Text="Data folder" />
    <TextBlock Margin="0,4,0,0"
               Text="{Binding DataFolderPath}"
               TextWrapping="Wrap" />
    <Button Margin="0,8,0,0"
            HorizontalAlignment="Left"
            Command="{Binding OpenDataFolderCommand}"
            Content="Open data folder" />
  </StackPanel>
</UserControl>
