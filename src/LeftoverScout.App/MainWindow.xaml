<Window x:Class="LeftoverScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeftoverScout.App.ViewModels"
        xmlns:views="clr-namespace:LeftoverScout.App.Views"
        Title="{Binding Title}"
        Width="1000"
        Height="650"
        MinWidth="900"
        MinHeight="600"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
      <views:PlaceholderPageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
      <views:AboutView />
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
    </StatusBar>

    <!-- Info bar (non-blocking), for example when the fallback data folder is used -->
    <Border DockPanel.Dock="Top"
            Padding="12,8"
            Background="#FFFFF4CE"
            BorderBrush="#FFE5CC73"
            BorderThickness="0,0,0,1"
            Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding DismissInfoBarCommand}"
                Content="Dismiss" />
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding InfoBarText}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Left navigation -->
    <ListBox DockPanel.Dock="Left"
             Width="180"
             Padding="4"
             BorderThickness="0,0,1,0"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding CurrentPage, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
          <TextBlock Margin="8,6" FontSize="14" Text="{Binding Title}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Content area -->
    <ContentControl Margin="24" Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
